 "scenes": [
  {
   "debut": 0.3,
   "fin": 7.85,
   "phrases": [
    {
     "debut": 0.3,
     "fin": 2.348,
     "texte": "Quand tu achètes, quelqu'un te vend."
    },
    {
     "debut": 2.668,
     "fin": 4.386,
     "texte": "Mais qui est de l'autre côté ?"
    },
    {
     "debut": 5.106,
     "fin": 6.63,
     "texte": "Et pourquoi est-il là ?"
    }
   ]
  },
  {
   "debut": 7.85,
   "fin": 16.557,
   "phrases": [
    {
     "debut": 7.85,
     "fin": 9.795,
     "texte": "D'abord, les banques centrales."
    },
    {
     "debut": 10.115,
     "fin": 12.09,
     "texte": "Elles fixent les taux directeurs."
    },
    {
     "debut": 12.41,
     "fin": 16.057,
     "texte": "Regarde : une seule décision, et le prix bouge d'un coup."
    }
   ]
  },
  {
   "debut": 16.557,
   "fin": 26.132,
   "phrases": [
    {
     "debut": 16.557,
     "fin": 19.181,
     "texte": "Ensuite, les banques, les fonds, les assureurs."
    },
    {
     "debut": 19.501,
     "fin": 21.245,
     "texte": "Ils gèrent des sommes énormes."
    },
    {
     "debut": 21.565,
     "fin": 22.396,
     "texte": "Tu vois ?"
    },
    {
     "debut": 23.116,
     "fin": 25.632,
     "texte": "Un seul de leurs ordres déplace le prix."
    }
   ]
  },
  {
   "debut": 26.132,
   "fin": 37.056,
   "phrases": [
    {
     "debut": 26.132,
     "fin": 30.56,
     "texte": "Les entreprises, elles, achètent des devises pour payer à l'étranger."
    },
    {
     "debut": 30.88,
     "fin": 33.315,
     "texte": "Souvent, elles fixent leur prix à l'avance."
    },
    {
     "debut": 33.635,
     "fin": 34.81,
     "texte": "Elles se couvrent."
    },
    {
     "debut": 35.13,
     "fin": 36.556,
     "texte": "Elles ne spéculent pas."
    }
   ]
  },
  {
   "debut": 37.056,
   "fin": 47.434,
   "phrases": [
    {
     "debut": 37.056,
     "fin": 42.173,
     "texte": "Les teneurs de marché affichent en permanence un prix d'achat et un prix de vente."
    },
    {
     "debut": 42.493,
     "fin": 43.882,
     "texte": "Ils gagnent l'écart."
    },
    {
     "debut": 44.202,
     "fin": 46.934,
     "texte": "Ton courtier, lui, te donne accès au marché."
    }
   ]
  },
  {
   "debut": 47.434,
   "fin": 56.128,
   "phrases": [
    {
     "debut": 47.434,
     "fin": 49.596,
     "texte": "Et puis les particuliers, comme toi."
    },
    {
     "debut": 49.916,
     "fin": 51.312,
     "texte": "Tes ordres pèsent peu."
    },
    {
     "debut": 51.632,
     "fin": 55.628,
     "texte": "Tu paies plus de frais, et tu vas moins vite que les professionnels."
    }
   ]
  },
  {
   "debut": 56.128,
   "fin": 66.933,
   "phrases": [
    {
     "debut": 56.128,
     "fin": 58.295,
     "texte": "Ce n'est pas une raison d'abandonner."
    },
    {
     "debut": 58.615,
     "fin": 60.44,
     "texte": "C'est une raison d'être humble."
    },
    {
     "debut": 60.76,
     "fin": 66.333,
     "texte": "Ton avantage ne viendra ni de la vitesse, ni de la taille, mais de ta discipline."
    }
   ]
  }
 ]
}
